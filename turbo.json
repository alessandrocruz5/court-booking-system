{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": ["TEST_DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/api/fixtures/**",
        "$TURBO_ROOT$/apps/web/src/content/site.ts"
      ],
      "outputs": []
    }
  }
}
