# Build context for apps/web/Dockerfile (the repo root). apps/backend/package.json stays in:
# turbo prune reads every workspace manifest.
**/node_modules
**/.next
**/.turbo
.git
**/.env*
!**/.env.example
coverage
docs/plans
apps/backend/.venv
apps/backend/staticfiles
**/__pycache__
# The deploy's google-github-actions/auth credential file, written to the workspace root.
# It must never reach a build layer or the GHA cache.
**/gha-creds-*.json
