# Copy to apps/backend/.env (gitignored). `pnpm --filter @cb/backend dev` runs
# `uv run --env-file .env`, which loads it; nothing else reads the file.
#
# Every key here is server only. The Docker build (`collectstatic`) needs none of them: settings
# import with an empty environment, and gunicorn refuses to start until the required ones are set
# (config/env.py REQUIRED_RUNTIME_ENV).

# Django's signing key: sessions, CSRF and password reset tokens. At least 50 characters. Generate
# one with `uv run python -c "import secrets; print(secrets.token_urlsafe(64))"`. Required at
# runtime; in Cloud Run it comes from Secret Manager.
DJANGO_SECRET_KEY=

# 1 for local development only: debug pages, http cookies, no HTTPS redirect, and localhost added
# to ALLOWED_HOSTS. Leave it unset in Cloud Run.
DJANGO_DEBUG=1

# The app's Postgres URL. Locally, the `db` service from compose.yaml
# (`docker compose up -d --wait db`). In Cloud Run, Neon's pooled (`-pooler`) URL for the app's
# login role, never the owner. Required at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/cb

# Comma-separated host names Django answers to. In Cloud Run, the service's run.app host.
# Required at runtime.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (scheme + host [+ port]) trusted for unsafe requests, such as the staff
# dashboard's forms. Required at runtime.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# The storefront's public origin (Next.js), no trailing slash. Used for absolute links, such as
# PayMongo's success and cancel redirects. Required at runtime.
SITE_URL=http://localhost:3000

# Shared secret the storefront's server sends as `Authorization: Bearer …` on /api/v1/*. At least
# 32 characters, and the same value as the web app's. Generate one with
# `uv run python -c "import secrets; print(secrets.token_urlsafe(48))"`. Required at runtime.
INTERNAL_API_TOKEN=

# The Neon owner's DIRECT connection string (the host without `-pooler`). Used only to run
# `migrate` from a laptop. Never put it in GitHub or Cloud Run.
MIGRATE_DATABASE_URL=
