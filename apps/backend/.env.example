# Copy to apps/backend/.env (gitignored). `pnpm --filter @cb/backend dev` runs
# `uv run --env-file .env`, which loads it; nothing else reads the file.
#
# Every key here is server only. The Docker build (`collectstatic`) needs none of them: settings
# import with an empty environment, and gunicorn refuses to start until the required ones are set
# (config/env.py REQUIRED_RUNTIME_ENV).

# Django's signing key: sessions, CSRF and password reset tokens. At least 50 characters. Generate
# one with `uv run python -c "import secrets; print(secrets.token_urlsafe(64))"`. Required at
# runtime; in Cloud Run it comes from Secret Manager.
DJANGO_SECRET_KEY=

# 1 for local development only: debug pages, http cookies, no HTTPS redirect, and localhost added
# to ALLOWED_HOSTS. Leave it unset in Cloud Run.
DJANGO_DEBUG=1

# The app's Postgres URL. Locally, the `db` service from compose.yaml
# (`docker compose up -d --wait db`). In Cloud Run, Neon's pooled (`-pooler`) URL for the app's
# login role, never the owner. Required at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/cb

# Comma-separated host names Django answers to. In Cloud Run, the service's run.app host.
# Required at runtime.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (scheme + host [+ port]) trusted for unsafe requests, such as the staff
# dashboard's forms. Required at runtime.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# The storefront's public origin (Next.js), no trailing slash. Used for absolute links, such as
# PayMongo's success and cancel redirects. Required at runtime.
SITE_URL=http://localhost:3000

# Shared secret the storefront's server sends as `Authorization: Bearer …` on /api/v1/*. The same
# value goes in apps/web's INTERNAL_API_TOKEN: one token shared by the two services. At least 32
# characters; generate one with `python3 -c "import secrets; print(secrets.token_urlsafe(40))"`.
# Server only: it never reaches a browser, and never gets a NEXT_PUBLIC_ prefix on the web side.
# Shorter or unset, every /api/v1/* request answers 503, and gunicorn refuses to start. Required
# at runtime; in Cloud Run it comes from Secret Manager.
INTERNAL_API_TOKEN=

# PayMongo's TEST secret key (`sk_test_…`), from the dashboard's API keys page with test mode on.
# A live or public key is refused. Read only when a checkout is created, looked up or expired, never
# at startup; in Cloud Run it comes from Secret Manager.
PAYMONGO_SECRET_KEY=

# The webhook's signing secret, shown on the PayMongo dashboard's webhook page (not an API key:
# `sk_…` and `pk_…` are refused). Read only by the webhook; in Cloud Run it comes from Secret
# Manager.
PAYMONGO_WEBHOOK_SECRET=

# 1 lets `manage.py seed_demo` and `manage.py nightly` regenerate the demo bookings (rows marked
# is_demo; real bookings are never touched). Set it locally and on the `cb-nightly` job only, never
# on the `cb-backend` service. Unset, `seed_demo` refuses to run and `nightly` skips the reseed.
ALLOW_DEMO_SEED=

# The staff dashboard's two accounts. `manage.py seed_staff` reads all four from the laptop and
# creates or updates the accounts (re-running it resets both passwords and signs both out). The
# demo button on Cloud Run (`cb-backend`) also reads DEMO_VIEWER_*, never the owner's pair. Each
# password at least 16 characters; generate one with
# `python3 -c "import secrets; print(secrets.token_urlsafe(24))"`.
STAFF_OWNER_EMAIL=
STAFF_OWNER_PASSWORD=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=

# The Neon owner's DIRECT connection string (the host without `-pooler`). Used only to run
# `migrate` from a laptop. Never put it in GitHub or Cloud Run.
MIGRATE_DATABASE_URL=
