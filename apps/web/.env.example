# Copy to apps/web/.env.local (gitignored).
#
# `next build` must never need any of these: they are read per request, so CI builds with no
# environment variables.

# Public origin, no trailing slash, read per request. Absolute URLs in metadata and robots.txt.
# Required at runtime: without it those return 500 and pages lose their metadata.
SITE_URL=http://localhost:3000

# The backend origin (Django, `apps/backend`), no trailing slash, read per request. Only server
# code calls it; browsers never do. Required at runtime: without it every API call fails.
API_URL=http://localhost:8000

# The shared service token for /api/v1/*: the same value as the backend's INTERNAL_API_TOKEN, at
# least 32 characters. Server only, never NEXT_PUBLIC_. Generate one with
# `python3 -c "import secrets; print(secrets.token_urlsafe(40))"`.
INTERNAL_API_TOKEN=

# The Django staff dashboard's URL, read per request. Only `/staff` (the "See the owner's side"
# link) reads it; without it `/staff` answers 500 and nothing else is affected.
DASHBOARD_URL=http://localhost:8000/dashboard/
