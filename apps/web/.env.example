# Copy to apps/web/.env.local (gitignored).
#
# `next build` must never need any of these: they are read per request, so CI builds with no
# environment variables.

# Public origin, no trailing slash, read per request. Absolute URLs in metadata and robots.txt.
# Required at runtime: without it those return 500 and pages lose their metadata.
SITE_URL=http://localhost:3000
